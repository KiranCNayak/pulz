# Copy to .env and fill in real values. Never commit .env.

# Postgres connection string (Neon/Supabase free tier or local Postgres).
# Prisma's expected format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pulz?schema=public"

# Port the Fastify + Socket.IO HTTP server listens on.
PORT=3000

# Host to bind to. 0.0.0.0 for containers/PaaS, 127.0.0.1 for local-only.
HOST=0.0.0.0

# Comma-separated list of origins allowed to call the REST API / connect the socket.
# e.g. "http://localhost:5173,https://pulz.example.com"
CORS_ORIGIN=http://localhost:5173

# Node environment: development | production | test
NODE_ENV=development

# Secret used to sign Creator auth sessions/JWTs (ARCHITECTURE.md §7).
# Generate a long random value for real deployments, e.g. `openssl rand -hex 32`.
AUTH_SECRET=change-me-in-real-env

# Default TTL (hours) for ResultsSnapshot rows before they're eligible for cleanup
# (DESIGN.md §7 / ARCHITECTURE.md §3). Host can configure a shorter window per session.
RESULTS_TTL_HOURS=24

# How often (minutes) the in-process sweep deletes expired ResultsSnapshot rows.
RESULTS_CLEANUP_INTERVAL_MINUTES=5

# Max POST /auth/register calls per IP per hour (Decision #38). Keep the
# default (10) in real deployments; the dev docker-compose stack raises it so
# repeated E2E runs don't trip it.
REGISTER_RATE_LIMIT_PER_HOUR=10

# OpenTelemetry → Grafana Cloud (docs/OBSERVABILITY.md). Telemetry is off
# while OTEL_EXPORTER_OTLP_ENDPOINT is unset. Values come from Grafana Cloud
# → your stack → OpenTelemetry → Configure. For `make dev` against the local
# Grafana from `make observe`, the endpoint is http://localhost:4318 and no
# headers are needed.
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-prod-<zone>.grafana.net/otlp
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic%20<base64 of instanceId:token>
# Don't set service.namespace here — it changes the `job` label the
# dashboard and alerts filter on.
# OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=production
