# Production image, deployed to Fly.io by backend/fly.toml (docs/DEPLOYMENT.md).
# The plain Dockerfile next to this one is the local dev image.

# --- build: compile TypeScript ---
FROM node:22-bookworm-slim AS build
RUN apt-get update && apt-get install -y --no-install-recommends openssl \
  && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY package.json package-lock.json ./
COPY prisma ./prisma
RUN npm ci
COPY . .
RUN npm run build

# --- runtime: production dependencies + compiled JS only ---
FROM node:22-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates \
  && rm -rf /var/lib/apt/lists/*
WORKDIR /app
ENV NODE_ENV=production
COPY package.json package-lock.json ./
COPY prisma ./prisma
# @prisma/client's postinstall generates the client from prisma/. The
# prisma CLI is a production dependency so fly.toml's release_command can
# run `prisma migrate deploy` from this same image.
RUN npm ci --omit=dev && npm cache clean --force
COPY --from=build /app/dist ./dist
USER node
EXPOSE 3000
CMD ["node", "dist/index.js"]
