{
  "name": "@pulz/backend",
  "version": "0.1.0",
  "private": true,
  "description": "Pulz backend: Fastify REST API + Socket.IO realtime layer + Prisma/Postgres persistence",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "test": "vitest run",
    "demo": "node scripts/seed-demo.mjs"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/otel": "^0.21.2",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-logs-otlp-proto": "^0.223.0",
    "@opentelemetry/exporter-metrics-otlp-proto": "^0.223.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.223.0",
    "@opentelemetry/instrumentation-http": "^0.223.0",
    "@opentelemetry/instrumentation-pino": "^0.69.0",
    "@opentelemetry/instrumentation-runtime-node": "^0.36.0",
    "@opentelemetry/instrumentation-socket.io": "^0.70.0",
    "@opentelemetry/sdk-node": "^0.223.0",
    "@opentelemetry/sdk-trace": "^2.12.0",
    "@prisma/client": "^5.20.0",
    "dotenv": "^16.4.5",
    "fastify": "^4.28.1",
    "prisma": "^5.22.0",
    "socket.io": "^4.8.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "socket.io-client": "^4.8.4",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=20"
  }
}
